# Copy to luan/.env.local (git-ignored) and fill in. Never commit real keys.

# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Voice to use (from: node luan/orchestrator/cli.mjs voices --provider elevenlabs)
ELEVENLABS_VOICE_ID=
# Vietnamese needs a v2.5 or v3 model
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Vbee — https://studio.vbee.vn/apps (Tích hợp API → Tạo ứng dụng)
VBEE_APP_ID=
VBEE_TOKEN=
VBEE_VOICE_CODE=hn_female_ngochuyen_full_48k-fhg

# Cost guard: max characters per voice-over call without explicit approval
LUAN_TTS_MAX_CHARS=3000
